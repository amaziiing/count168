[Unit]
Description=count168.org Transaction Payment SSE realtime hub
After=network.target
# Optional: Wants=redis.service when REDIS_URL is set in .env

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/var/www/count168.org/services/tx-realtime
EnvironmentFile=-/var/www/count168.org/services/tx-realtime/.env
Environment=NODE_ENV=production
Environment=TX_REALTIME_HOST=127.0.0.1
Environment=TX_REALTIME_PORT=3912
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
